# --- Base de données ---
DATABASE_URL="postgresql://dataflow:dataflow@localhost:5432/dataflow_ci?schema=public"

# --- Queue (Redis / BullMQ, câblé quand packages/queue sera implémenté) ---
REDIS_URL="redis://localhost:6379"

# --- Stockage fichiers (S3 / MinIO en local, câblé quand packages/storage sera implémenté) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dataflow-ci-files"
S3_ACCESS_KEY_ID="dataflow"
S3_SECRET_ACCESS_KEY="dataflow-secret"
S3_FORCE_PATH_STYLE="true"

# --- Authentification (Auth.js) ---
# Génère une vraie valeur en local avec : openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-minimum-secret"
AUTH_URL="http://localhost:3000"

# --- Couche IA additive (optionnelle — voir DECISIONS.md ADR-034/035) ---
# Absente/vide : les fonctionnalités IA (Copilot qualité de données, assistant
# d'inférence de schéma) se désactivent proprement, le reste de l'application
# n'est jamais affecté. Les trois variables doivent être présentes ensemble.
# OLLAMA_API_KEY="ollama-api-key"
# OLLAMA_BASE_URL="https://ollama.com"
# OLLAMA_MODEL="llama3.1"

# --- Webhooks sortants (optionnel — voir DECISIONS.md ADR-040) ---
# Absent : les webhooks partent quand même, simplement non signés.
# WEBHOOK_SIGNING_SECRET="change-me-to-a-random-secret"

NODE_ENV="development"
